#!/usr/bin/env bash
# Usage: git resolve-conflicts [claude options]
#
# Starts Claude Code in the current repo with the prompt "Resolve git conflicts".
# Extra arguments go to claude, e.g. headless run:
#   git resolve-conflicts -p --permission-mode acceptEdits --allowedTools "Bash(git *)"
# Uses whatever CLAUDE_CONFIG_DIR is set (pclaude: ~/.claude-personal).
set -e

if [[ $1 = "-h" || $1 = "--help" ]]; then
  sed -ne '/^#/!q;s/.\{1,2\}//;1d;p' < "$0"
  exit 0
fi

if [[ -z $(git diff --name-only --diff-filter=U) ]]; then
  echo "No unmerged files." >&2
  exit 1
fi

exec claude "$@" "Resolve git conflicts"
