###########
# HISTORY #
###########

# Points directly into dotfiles-private instead of a ~/.zshhistory symlink:
# zsh rewrites the history file via rename() on every clean exit, which would
# replace the symlink with a regular file.
HISTFILE=~/projs/swistak35/dotfiles-private/histories/zshhistory
HISTSIZE=5000000
export SAVEHIST=$HISTSIZE

# When a new command duplicates an older one, drop the older entry
setopt hist_ignore_all_dups

# Don't record commands typed with a leading space
setopt hist_ignore_space

# One live history shared across all running shells (tmux panes, terminals):
# writes each command immediately and re-reads others' commands before each
# prompt. This subsumes append_history and inc_append_history, so they're
# not set — see the manual's note under SHARE_HISTORY.
setopt share_history

# Store timestamp + duration per command (share_history forces this format on
# write anyway; setting it explicitly makes it not depend on that side-effect)
setopt extended_history

# Trim redundant whitespace from a command before saving it
setopt hist_reduce_blanks

# History expansion (!!, !vim, ...) drops the result into the edit buffer to
# confirm, instead of running it immediately
setopt hist_verify



