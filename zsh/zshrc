# One shared ssh-agent for all shells, run as a systemd user service with a
# stable socket (ssh/ssh-agent.service) — instead of spawning an agent per
# shell. Keep a forwarded agent when SSHing in from another machine.
if [[ -z "$SSH_CONNECTION" || -z "$SSH_AUTH_SOCK" ]]; then
  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket"
fi

# Load keys in the first shell after boot, with GUI passphrase prompt
# (ssh-add -l exit 1 = agent reachable but has no identities yet)
ssh-add -l > /dev/null 2>&1
if [ $? = 1 ]; then
    SSH_ASKPASS=ksshaskpass ssh-add ~/.ssh/id_rsa < /dev/null 2>/dev/null || true
    SSH_ASKPASS=ksshaskpass ssh-add ~/.ssh/id_ed25519 < /dev/null 2>/dev/null || true
fi

